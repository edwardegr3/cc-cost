// Credit Compass data model. The database is Render PostgreSQL;
// the connection string comes only from the DATABASE_URL env var.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// One row per line of credit_products.csv (synthetic data).
model Product {
  id             String   @id // product_id, e.g. "CC-P01"
  name           String
  type           String
  nominalRatePct Decimal  @db.Decimal(6, 3)
  setupFeeEur    Decimal  @db.Decimal(10, 2)
  monthlyFeeEur  Decimal  @db.Decimal(10, 2)
  minAmountEur   Int
  maxAmountEur   Int
  minTermMonths  Int
  maxTermMonths  Int
  notes          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// One row per line of credit_faq.csv.
model Faq {
  id        Int      @id @default(autoincrement())
  topic     String
  question  String   @unique
  keywords  String[]
  answer    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([topic])
  @@map("FAQ")
}

model ChatSession {
  id        String    @id @default(cuid())
  title     String    @default("New chat")
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([updatedAt])
}

enum MessageRole {
  user
  assistant
}

model Message {
  id        String      @id @default(cuid())
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  role      MessageRole
  content   String
  createdAt DateTime    @default(now())

  @@index([sessionId, createdAt])
}

// Single row (id "default") holding assistant settings.
model ChatSettings {
  id               String   @id @default("default")
  assistantName    String   @default("Credit Compass Assistant")
  welcomeMessage   String
  fallbackMessage  String
  maxMessageLength Int      @default(1000)
  updatedAt        DateTime @updatedAt
}
