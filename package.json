{
  "name": "cc-cost",
  "version": "0.1.0",
  "private": true,
  "description": "Credit Compass: Consumer Credit Cost & Affordability Education Assistant",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npm run db:seed || echo 'Seed skipped: database unavailable'; next start -H 0.0.0.0 -p ${PORT:-3000}",
    "lint": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "22.20.5",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.10",
    "lucide-react": "1.50.0",
    "next": "15.5.28",
    "prisma": "6.19.3",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "tailwindcss": "4.1.18",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
